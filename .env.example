# ==============================================================================
# VIDUR SALES PLATFORM — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vercel Project Settings)
# Only variables prefixed with VITE_ are exposed to the client bundle.
# ------------------------------------------------------------------------------
# Live Render API server URL (e.g., https://vidur-api.onrender.com)
VITE_API_URL=https://vidur-api.onrender.com

# Live Render WebSocket URL (e.g., wss://vidur-api.onrender.com)
VITE_WS_URL=wss://vidur-api.onrender.com


# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Render Web Service Environment Settings)
# These are strictly server-side and NEVER bundled or exposed to the client.
# ------------------------------------------------------------------------------
# Environment mode: development | production | test
ENVIRONMENT=production

# Server Port (Render sets this dynamically via $PORT)
PORT=8000

# PostgreSQL Connection String (Render provides this via Managed Database)
# e.g., postgresql://vidur_user:password@dpg-xxxx-a.oregon-postgres.render.com/vidur_sales
DATABASE_URL=postgresql://vidur_user:password@localhost:5432/vidur_sales

# Secret Key for JWT Signing & Token Authentication (Minimum 32 characters)
SECRET_KEY=generate-a-strong-random-32-byte-hex-key-here

# CORS Allowed Origins (Comma-separated list or JSON array; supports Vercel domains)
CORS_ORIGINS=https://vidur-sales-os.vercel.app,http://localhost:3000,http://localhost:5173

# Logging Level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# --- Telephony Carrier Credentials (Phase 6) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+15550199000
EXOTEL_SID=
EXOTEL_TOKEN=

# --- CRM Integrations OAuth (Phase 5) ---
HUBSPOT_CLIENT_ID=vidur-hubspot-oauth-client
HUBSPOT_CLIENT_SECRET=vidur-hubspot-secret-key
HUBSPOT_REDIRECT_URI=https://vidur-sales-os.vercel.app/settings/integrations/hubspot/callback

# --- AI Voice Models & Sarvam Cloud API (Phase 6/8) ---
SARVAM_API_KEY=your_sarvam_api_key_here
SARVAM_LLM_MODEL=sarvam-105b
AI_PROVIDER=sarvam
LLM_PROVIDER=sarvam
STT_PROVIDER=sarvam
TTS_PROVIDER=sarvam

